def path_to_trajectory(P, cost_mode="distance"):
    if not P:
        return None
    pts = [cell_to_meters(X) for X in P]          # centre of each cell, in m
    T = []
    t = 0.0
    for j in range(len(P)):
        x, y = pts[j]
        # time stamp
        if j > 0:
            d = math.hypot(x - pts[j - 1][0], y - pts[j - 1][1])
            if cost_mode == "time":
                s = traversability(P[j]) * ROBOT_SPEED_M_S
            else:
                s = ROBOT_SPEED_M_S
            t += d / s
        # heading: look HEADING_LOOKAHEAD_CELLS ahead
        m = min(j + HEADING_LOOKAHEAD_CELLS, len(P) - 1)
        if m > j:
            theta = math.atan2(pts[m][1] - y, pts[m][0] - x)
        elif j > 0:
            theta = T[-1][3]                      # last cell: keep previous heading
        else:
            theta = 0.0                           # path of a single cell
        T.append([t, x, y, theta])
    return T
    
